# StoryGen configuration — copy to .env and edit locally. Never commit real keys.
# Default authentication: Google AI Studio (Gemini Developer API).
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=REPLACE_LOCALLY

# Required for Vertex AI mode; also used for optional private GCS storage.
GOOGLE_CLOUD_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_REGION=us-central1

# Optional: leave blank to receive inline images without Cloud Storage.
GENMEDIA_BUCKET=
# Prefer Application Default Credentials. If using a key file, keep it OUTSIDE Git.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json

# Configurable model IDs; verify access in your project before a live smoke test.
STORY_MODEL=gemini-3.8-flash
IMAGE_MODEL=gemini-nano-banana-2.1
STORY_TIMEOUT_SECONDS=60
IMAGE_TIMEOUT_SECONDS=60
IMAGE_URL_TTL_SECONDS=3600

# Deployment names (used by the workshop deployment scripts).
GITHUB_USERNAME=REPLACE_WITH_YOUR_GITHUB_USERNAME
GITHUB_REPO=storygen-learning
SECRET_MANAGER=storygen-google-api-key
REGION=us-central1
BACKEND_SERVICE_NAME=genai-backend
FRONTEND_SERVICE_NAME=genai-frontend
BACKEND_IMAGE_NAME=storygen-backend
FRONTEND_IMAGE_NAME=storygen-frontend
ARTIFACT_REPO=storygen-repo
BACKEND_MEMORY=2Gi
BACKEND_CPU=2
FRONTEND_MEMORY=1Gi
FRONTEND_CPU=1
MIN_INSTANCES=0
MAX_INSTANCES=2
